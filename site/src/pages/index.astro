---
import Layout from '../components/Layout.astro';
import { CURRENT_VERSION } from '../lib/versions.ts';

const base = import.meta.env.BASE_URL;
const u = (r: string) => base.replace(/\/$/, '') + r;
---

<Layout
  title="Adaptive AI Systems Playbook"
  description="An evidence-driven, project-independent methodology for building AI systems — read, navigate, and learn it here."
  section=""
>
  <div class="hero">
    <p class="overline">Adaptive AI Lab · Playbook v{CURRENT_VERSION}</p>
    <h1>The Adaptive AI Systems Playbook, built for deep reading.</h1>
    <p class="lede">
      An evidence-driven, project-independent methodology for designing, evaluating, optimizing,
      deploying, and continuously improving AI systems. Every rule carries its evidence and how strong
      that evidence is — including the rules that rest only on reasoning.
    </p>
    <div class="hero-actions">
      <a class="btn primary" href={u('/playbook/quickstart/')}>Start with the Quickstart</a>
      <a class="btn secondary" href={u('/playbook/')}>Browse the book</a>
      <a class="btn secondary" href={u('/learn/')}>See the lifecycle map</a>
    </div>
  </div>

  <h2 class="section-h">What the playbook answers</h2>
  <p class="section-sub">
    For a concrete project: what should I do next, why, what evidence do I need, what should I measure,
    what can I skip, what should force me to stop — and when is an expensive intervention justified?
  </p>

  <div class="card-grid ui">
    <a class="card" href={u('/playbook/')}>
      <span class="card-title">The book</span>
      Chapters 00–14: principles, evaluation, experiment design, selection, optimization, economics,
      deployment, governance.
    </a>
    <a class="card" href={u('/playbook/glossary/')}>
      <span class="card-title">Glossary</span>
      101 defined terms with hover definitions across the whole site — the fastest way into the
      methodology's vocabulary.
    </a>
    <a class="card" href={u('/playbook/templates/project-profile/')}>
      <span class="card-title">Templates</span>
      Nine working artifacts, from the project profile to experiment contracts and the three ledgers.
    </a>
    <a class="card" href={u('/cases/')}>
      <span class="card-title">Scenarios</span>
      Twelve worked scenarios, ten compact examples, and one full walkthrough — every one invented, each
      built around a mistake that is easy to make.
    </a>
    <a class="card" href={u('/references/sources/')}>
      <span class="card-title">Source ledger</span>
      Every cited source with a verdict (FOLLOW / ADAPT / REFERENCE / DEPRECATED), strength, and
      verification date.
    </a>
    <a class="card" href={u('/changelog/')}>
      <span class="card-title">Changelog</span>
      Release history, with the evidence behind each rule change.
    </a>
  </div>

  <h2 class="section-h">How a rule gets in here</h2>
  <p class="section-sub">
    Nothing becomes a rule because it sounds right. A claim starts as evidence, gets a strength label
    saying how far it can be pushed, and only then becomes something the book tells you to do. Scenarios
    illustrate the rules; they are never the evidence for them.
  </p>
  <div class="pb-map" style="max-width:44rem">
    <ol>
      {
        [
          { n: 'Sources', d: 'every citation, with a verdict and a verification date', href: '/references/sources/' },
          { n: 'Strength labels', d: 'consensus, strong evidence, or inference — stated, never implied', href: '/playbook/00-principles-and-scope/' },
          { n: 'The rules', d: 'the methodology itself, chapters 00-14', href: '/playbook/' },
          { n: 'Scenarios', d: 'invented projects that show each rule being ignored, and what it cost', href: '/cases/' },
          { n: 'Changes', d: 'when evidence moves, the rule moves - and the changelog says why', href: '/changelog/' },
        ].map((s) => (
          <li class="map-stage">
            <span class="map-rail" aria-hidden="true">
              <span class="map-dot" />
              <span class="map-line" />
            </span>
            <a class="map-card" href={u(s.href)} style="display:block">
              <span class="stage-name">{s.n}</span>
              <p class="stage-desc" style="margin-bottom:0">{s.d}</p>
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  <footer class="site-footer">
    A reading interface over the playbook's Markdown source. ·
    <a href={u('/about/')}>About this playbook</a>
  </footer>
</Layout>
