---
interface Props {
  section?: string;
  space?: string | null;
}
const { section = '', space = null } = Astro.props;
const base = import.meta.env.BASE_URL;
const u = (r: string) => base.replace(/\/$/, '') + r;

const nav = [
  { label: 'Playbook', href: u('/playbook/'), key: 'playbook' },
  { label: 'Learn', href: u('/learn/'), key: 'learn' },
  { label: 'Cases', href: u('/cases/'), key: 'cases' },
  { label: 'References', href: u('/references/sources/'), key: 'references' },
  { label: 'Changelog', href: u('/changelog/'), key: 'changelog' },
  { label: 'About', href: u('/about/'), key: 'about' },
];
---

<header class="site-header ui">
  <div class="header-inner">
    <button
      id="sidebar-toggle"
      class="icon-btn sidebar-toggle"
      aria-label="Toggle navigation"
      aria-expanded="false"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
    <a class="brand" href={u('/')}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">Adaptive AI Lab</span>
      {space && <span class="badge">v{space} snapshot</span>}
    </a>
    <nav class="top-nav" aria-label="Site">
      {nav.map((n) => (
        <a href={n.href} aria-current={section === n.key ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <button id="search-open" class="search-btn" aria-label="Search (press slash)">
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
          <circle cx="6.5" cy="6.5" r="4.7" stroke="currentColor" stroke-width="1.5" />
          <path d="M10.2 10.2 13.6 13.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <span class="search-label">Search</span>
        <kbd>/</kbd>
      </button>
      <div class="mode-switch" role="group" aria-label="Appearance mode">
        <button data-mode-set="light" aria-label="Light mode" title="Light">
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
            <circle cx="7.5" cy="7.5" r="3.2" stroke="currentColor" stroke-width="1.4" />
            <path
              d="M7.5 1v1.6M7.5 12.4V14M14 7.5h-1.6M2.6 7.5H1M12.1 2.9l-1.2 1.2M4.1 10.9l-1.2 1.2M12.1 12.1l-1.2-1.2M4.1 4.1 2.9 2.9"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
            />
          </svg>
        </button>
        <button data-mode-set="dim" aria-label="Dim mode (low-contrast dark for long reading)" title="Dim">
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
            <circle cx="7.5" cy="7.5" r="5.4" stroke="currentColor" stroke-width="1.4" />
            <path d="M7.5 2.1a5.4 5.4 0 0 0 0 10.8Z" fill="currentColor" />
          </svg>
        </button>
        <button data-mode-set="dark" aria-label="Dark mode" title="Dark">
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
            <path
              d="M12.9 9.4A5.9 5.9 0 0 1 5.6 2.1a5.9 5.9 0 1 0 7.3 7.3Z"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>
