---
/**
 * Version selector + (on historical pages) the archive banner identifying the
 * exact commit the page was extracted from.
 */
import { VERSIONS, CURRENT_VERSION, versionMeta } from '../lib/versions.ts';
import { pagesInSpace, type Space } from '../lib/corpus.ts';
import { githubCommitUrl } from '../lib/repo.ts';

interface Props {
  space: Space;
  /** space-relative route of this page */
  route: string;
}
const { space, route } = Astro.props;
const base = import.meta.env.BASE_URL;
const u = (r: string) => base.replace(/\/$/, '') + r;

const existsIn = (s: Space) => pagesInSpace(s).some((p) => p.route === route);

const options = [
  {
    key: 'current',
    label: `Current — v${CURRENT_VERSION}`,
    sub: 'working tree',
    href: u(route),
    active: space === null,
    exists: true,
  },
  ...VERSIONS.map((v) => ({
    key: v.version,
    label: `v${v.version} snapshot`,
    sub: v.commit.slice(0, 12),
    href: u(`/versions/${v.version}${route}`),
    active: space === v.version,
    exists: existsIn(v.version),
  })),
];
const current = options.find((o) => o.active) ?? options[0]!;
const meta = space ? versionMeta(space) : null;
---

<details class="version-menu">
  <summary aria-label="Playbook version">
    <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <circle cx="3.5" cy="3" r="1.7" stroke="currentColor" stroke-width="1.3" />
      <circle cx="3.5" cy="9" r="1.7" stroke="currentColor" stroke-width="1.3" />
      <circle cx="8.9" cy="6" r="1.7" stroke="currentColor" stroke-width="1.3" />
      <path d="M3.5 4.7v2.6M5.2 3.6c2.4.6 3.4.9 3.7 2.4" stroke="currentColor" stroke-width="1.1" />
    </svg>
    {current.label.replace(' — ', ' · ')}
    <span aria-hidden="true">▾</span>
  </summary>
  <div class="menu" role="menu">
    {options.map((o) =>
      o.exists ? (
        <a href={o.href} role="menuitem" aria-current={o.active ? 'true' : undefined}>
          <span class="v-label">{o.label}</span>
          <span class="v-sub">{o.sub}</span>
        </a>
      ) : (
        <span class="disabled">
          <span class="v-label">{o.label}</span>
          <span class="v-sub">page not present in this version</span>
        </span>
      ),
    )}
    <a href={u('/versions/')} role="menuitem"><span class="v-label">About versions…</span></a>
  </div>
</details>

{
  meta && (
    <div class="archive-banner" role="note">
      <strong>Historical snapshot.</strong> You are reading playbook v{meta.version} exactly as released on{' '}
      {meta.date}, extracted from commit{' '}
      <a href={githubCommitUrl(meta.commit)} class="mono" rel="noopener">
        {meta.commit.slice(0, 12)}
      </a>
      . It is not the current methodology.{' '}
      {existsIn(null) ? <a href={u(route)}>Read the current version →</a> : <a href={u('/playbook/')}>Go to the current playbook →</a>}
    </div>
  )
}
