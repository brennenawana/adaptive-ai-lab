---
/** Standard rendered-document page: chapters, templates, cases, quickstart… */
import Layout from './Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PrevNext from './PrevNext.astro';
import { renderCanonicalDoc } from '../lib/rendering.ts';
import { sidebarFor, prevNext } from '../lib/nav.ts';
import { STAGES, stageForChapter, CROSS_CUTTING } from '../lib/lifecycle.ts';
import { spacePrefix } from '../lib/routes.ts';
import { CURRENT_VERSION } from '../lib/versions.ts';
import { pagesInSpace, type PageDef } from '../lib/corpus.ts';

interface Props {
  page: PageDef;
}
const { page } = Astro.props;
const base = import.meta.env.BASE_URL;
const u = (r: string) => base.replace(/\/$/, '') + r;
const pre = spacePrefix(page.space);

const doc = renderCanonicalDoc(page.space, page.repoPath, base);
const title = doc.title ?? page.repoPath;
const sidebar = sidebarFor(page.section, page.space);
const { prev, next } = prevNext(page);

const isPlaybookScope = page.repoPath.startsWith('playbook/');
const chapterNum = page.repoPath.match(/^playbook\/(\d\d)_/)?.[1] ?? null;

/* chapter orientation */
const chapterRoute = new Map(
  pagesInSpace(page.space)
    .filter((p) => /^playbook\/\d\d_/.test(p.repoPath))
    .map((p) => [p.repoPath.match(/^playbook\/(\d\d)_/)![1]!, p.fullRoute]),
);
const stageIdx = chapterNum ? stageForChapter(chapterNum) : -1;
const crossCutting = chapterNum ? CROSS_CUTTING.find((c) => c.num === chapterNum) : undefined;
const jumpSections = doc.toc.filter((t) =>
  /^(3\. Decisions|5\. Default procedure|7\. Decision gates|9\. Failure modes|12\. Outputs|13\. Sources)/.test(t.text),
);

/* breadcrumbs */
const sectionCrumb: Record<string, { label: string; route: string }> = {
  playbook: { label: 'Playbook', route: `${pre}/playbook/` },
  references: { label: 'References', route: `${pre}/references/sources/` },
  cases: { label: 'Cases', route: `${pre}/cases/` },
  changelog: { label: 'Changelog', route: `${pre}/changelog/` },
};
const crumbs = [
  { label: 'Home', href: '/' },
  { label: sectionCrumb[page.section]?.label ?? page.section, href: sectionCrumb[page.section]?.route },
  { label: title },
];

const description = `${title} — Adaptive AI Systems Playbook${page.space ? ` v${page.space} (historical snapshot)` : ` v${CURRENT_VERSION}`}`;
---

<Layout
  title={page.space ? `${title} (v${page.space})` : title}
  description={description}
  section={page.section}
  sidebar={sidebar}
  toc={doc.toc}
  space={page.space}
  route={page.route}
>
  <header class="doc-head">
    <div class="doc-eyebrow" data-pagefind-ignore="all">
      <Breadcrumbs crumbs={crumbs} />
      {isPlaybookScope && (
        <span class="version-bar">
        </span>
      )}
    </div>
    <h1>{title}</h1>
    {
      (doc.meta.readingTime || doc.meta.governingChapter) && (
        <p class="doc-meta-row">
          {doc.meta.readingTime && <span>Reading time {doc.meta.readingTime}</span>}
          {doc.meta.governingChapter && (
            <span>
              Governing chapter: <Fragment set:html={doc.meta.governingChapter} />
            </span>
          )}
        </p>
      )
    }
    {doc.meta.templateLede && <p class="doc-meta-row"><Fragment set:html={doc.meta.templateLede} /></p>}
  </header>

  {/* chapter orientation panel */}
  {
    chapterNum && (
      <div class="orientation ui">
        {stageIdx >= 0 ? (
          <p class="lifecycle-strip" aria-label="Position in the playbook lifecycle">
            {STAGES.map((s, i) => (
              <span class:list={['stage', { here: i === stageIdx }]}>
                {i === stageIdx ? (
                  s.name
                ) : (
                  <a href={u(chapterRoute.get(s.chapters[0]!) ?? `${pre}/playbook/`)} title={`${s.name} — chapter ${s.chapters[0]}`} aria-label={s.name}>
                    ·
                  </a>
                )}
              </span>
            ))}
          </p>
        ) : (
          crossCutting && <p class="lifecycle-strip">Cross-cutting: {crossCutting.role}.</p>
        )}
        <dl>
          {doc.meta.prerequisites && (
            <>
              <dt>Read first</dt>
              <dd><Fragment set:html={doc.meta.prerequisites} /></dd>
            </>
          )}
          {stageIdx >= 0 && (
            <>
              <dt>Lifecycle stage</dt>
              <dd>
                {STAGES[stageIdx]!.name} — {STAGES[stageIdx]!.desc}{' '}
                <a href={u('/learn/')}>(full map)</a>
              </dd>
            </>
          )}
          {jumpSections.length > 0 && (
            <>
              <dt>Jump to</dt>
              <dd class="jump-links">
                {jumpSections.map((j) => (
                  <a href={`#${j.slug}`}>{j.text.replace(/^\d+\.\s*/, '')}</a>
                ))}
              </dd>
            </>
          )}
        </dl>
      </div>
    )
  }

  {doc.meta.synthDisclaimer && (
    <div class="evidence-banner" role="note">
      <div>
        <p class="overline">Synthetic worked example</p>
        <p><Fragment set:html={doc.meta.synthDisclaimer} /></p>
      </div>
    </div>
  )}

  <div class="prose">
    <Fragment set:html={doc.html} />
  </div>

  <PrevNext prev={prev} next={next} />
</Layout>
