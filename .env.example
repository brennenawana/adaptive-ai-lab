# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- Frontier tier: Claude via subscription (no API key) ----
# Produced by: claude setup-token
# Must be a SINGLE line. Terminals wrap long tokens on paste; a wrapped token
# silently truncates and auth fails with a confusing error later.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# ---- Frontier tier: Codex via subscription (no API key) ----
# Produced by: codex login   (writes ~/.codex/auth.json — nothing to put here)

# ---- Local inference ----
FIS_LOCAL_MODEL_BASE_URL=http://127.0.0.1:8082/v1
FIS_LOCAL_MODEL_NAME=qwen3-8b

# ---- Datastores (ports offset from this machine's existing services) ----
# 5432 = pre-existing "thewall" Postgres, 6379 = pre-existing Redis — untouched.
FIS_PG_DSN=postgresql://fis:fis_local_dev@127.0.0.1:5433/fis
FIS_NATS_URL=nats://127.0.0.1:4222

# ---- Eval / cost accounting ----
# Marginal cost on a subscription is ~zero, so the intelligence-density KPI uses
# reference API list prices recomputed from token counts, not amounts billed.
FIS_COST_MODE=reference_list_price
