    "json_schema": {
      "name": "fis_output",
      "schema": {
        "$defs": {
          "Fact": {
            "additionalProperties": false,
            "description": "A claim the model asserts as true. Requires a tool citation, always.\n\n`source` must be a tool:// URI naming the call that produced it, so the verifier\ncan confirm the referenced call actually happened in this trajectory.",
            "properties": {
              "claim": {
                "title": "Claim",
                "type": "string"
              },
              "entity_ids": {
                "items": {
                  "type": "string"
                },
                "title": "Entity Ids",
                "type": "array"
              },
              "source": {
                "pattern": "^tool://[a-z_]+/[A-Za-z0-9_./:-]+$",
                "title": "Source",
                "type": "string"
              }
            },
            "required": [
              "claim",
              "source"
            ],
            "title": "Fact",
            "type": "object"
          },
          "NextAction": {
            "description": "Allowed action codes. Read-only project: these are recommendations an\noperator executes, never something the AI performs.",
            "enum": [
              "open_reconciliation_review",
              "inspect_mapping_version",
              "replay_webhook",
              "contact_identity_vendor",
              "request_kyc_documents",
              "escalate_to_risk_team",
              "release_risk_hold_review",
              "no_action_required",
              "escalate_to_engineering"
            ],
            "title": "NextAction",
            "type": "string"
          },
          "RootCause": {
            "additionalProperties": false,
            "properties": {
              "confidence": {
                "title": "Confidence",
                "type": "number"
              },
              "label": {
                "$ref": "#/$defs/RootCauseLabel"
              }
            },
            "required": [
              "label",
              "confidence"
            ],
            "title": "RootCause",
            "type": "object"
          },
          "RootCauseLabel": {
            "description": "Closed label set, matching the twelve seeded scenario classes.\n\nClosed rather than free-text because root-cause accuracy is scored by exact or\naccepted-label match \u2014 the guide is explicit that we should not ask an LLM judge\nto grade something we can test objectively.",
            "enum": [
              "duplicate_webhook_handled",
              "missing_idempotency",
              "kyc_hold",
              "provider_outage",
              "processor_decline",
              "settlement_amount_mapping_error",
              "reversal_race",
              "risk_hold",
              "stale_integration_mapping",
              "reconciliation_gap",
              "false_positive_alert",
              "compound_failure",
              "unknown"
            ],
            "title": "RootCauseLabel",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "The structured case assessment. This is the schema the verifier validates and\nthe scorer grades against the hidden manifest.",
        "properties": {
