            "title": "Case Id",
            "type": "string"
          },
          "classification": {
            "title": "Classification",
            "type": "string"
          },
          "escalation_required": {
            "default": false,
            "title": "Escalation Required",
            "type": "boolean"
          },
          "facts": {
            "items": {
              "$ref": "#/$defs/Fact"
            },
            "title": "Facts",
            "type": "array"
          },
          "hypotheses": {
            "items": {
              "type": "string"
            },
            "title": "Hypotheses",
            "type": "array"
          },
          "recommended_next_action": {
            "$ref": "#/$defs/NextAction"
          },
          "root_cause": {
            "$ref": "#/$defs/RootCause"
          },
          "summary": {
            "title": "Summary",
